#!/usr/bin/env bash
# tui - interactive terminal dashboard for server-toolkit (Sprint 14).
#
# Pure Bash, zero new dependencies - reuses the exact same lib/*.sh
# diagnostic functions bin/info already calls; this file only adds a
# rendering/interaction layer on top, it never recomputes how any metric
# is gathered. See docs/tui.md for the user-facing guide.
#
# TUI_ONCE=1 (env var) renders exactly one frame to plain stdout and
# exits 0 - it never touches terminal modes (no alternate screen, no raw
# input read, no TTY requirement), so it is safe to run non-interactively.
# This is how almost all of this sprint's automated tests drive the real
# rendering code, since a genuine interactive session can't be scripted.
#
# SECURITY: keyboard input is only ever compared against a fixed
# whitelist of single characters (tui_key_action, below) - never
# dynamically interpreted as code, never bash -c/sh -c, never used to
# build a command or a path.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"
LIB_DIR="$(cd -- "${SCRIPT_DIR}/../lib" >/dev/null 2>&1 && pwd -P)"

# shellcheck source=../lib/common.sh
source "${LIB_DIR}/common.sh"
# shellcheck source=../lib/system.sh
source "${LIB_DIR}/system.sh"
# shellcheck source=../lib/gpu.sh
source "${LIB_DIR}/gpu.sh"
# shellcheck source=../lib/docker.sh
source "${LIB_DIR}/docker.sh"
# shellcheck source=../lib/services.sh
source "${LIB_DIR}/services.sh"
# shellcheck source=../lib/security.sh
source "${LIB_DIR}/security.sh"
# shellcheck source=../lib/process.sh
source "${LIB_DIR}/process.sh"
# shellcheck source=../lib/logs.sh
source "${LIB_DIR}/logs.sh"
# shellcheck source=../lib/status.sh
source "${LIB_DIR}/status.sh"
# shellcheck source=../lib/config.sh
source "${LIB_DIR}/config.sh"
# shellcheck source=../lib/modules.sh
source "${LIB_DIR}/modules.sh"

# The one place this version string is defined.
TOOLKIT_TUI_VERSION="0.14.0-dev"

# Below this many columns, the dashboard renders as a single-column,
# unboxed label:value listing instead of the two-column boxed layout.
TUI_MIN_FULL_WIDTH=70

# ------------------------------------------------------- pure helpers ---
# Everything in this section takes explicit arguments (or checks only
# well-defined environment/tput state) and produces output or an exit
# status with no other side effect - testable by calling directly, no
# terminal required.

# True (exit 0) iff color output should be used: NO_COLOR unset, stdout
# is a real terminal, and that terminal reports at least 8 colors.
# Not yet called by any render path in this release - color output is
# reserved for a future sprint, see docs/tui.md's Colors section.
tui_color_enabled() {
    [[ -n "${NO_COLOR:-}" ]] && return 1
    [[ -t 1 ]] || return 1
    local n
    n="$(tput colors 2>/dev/null)" || return 1
    [[ "$n" =~ ^[0-9]+$ ]] && [[ "$n" -ge 8 ]]
}

# Prints "full" or "narrow" for a given column count (defaults to the
# real terminal width via tput, falling back to 80 if that fails - same
# fallback lib/common.sh::term_width already uses).
tui_layout_mode() {
    local cols="${1:-}"
    if [[ -z "$cols" ]]; then
        cols="$(tput cols 2>/dev/null)" || cols=""
    fi
    [[ "$cols" =~ ^[0-9]+$ ]] || cols=80
    if [[ "$cols" -ge "$TUI_MIN_FULL_WIDTH" ]]; then
        printf 'full'
    else
        printf 'narrow'
    fi
}

# Maps one keypress character to an action name. The empty string means
# "read timed out, no key was pressed" (an automatic refresh tick).
# Anything not explicitly listed maps to "ignore" - a fixed whitelist,
# never a fallthrough that could be misused as a dispatch table for
# arbitrary input.
tui_key_action() {
    case "${1:-}" in
        q|Q) printf 'quit' ;;
        r|R) printf 'refresh' ;;
        h|H|'?') printf 'help' ;;
        '') printf 'timeout' ;;
        *) printf 'ignore' ;;
    esac
}

# Prints two blocks of already-rendered text side by side, each padded
# to $col_width, separated by " | ". Pads the shorter block with blank
# lines. Deliberately plain-ASCII-only in practice (see docs/tui.md) -
# padding is byte-width, not display-width, so a UTF-8 status glyph
# embedded in a column would misalign; panel content that uses glyphs
# (the ALERTS section) is rendered full-width, never inside a column.
tui_two_col() {
    local left="$1" right="$2" col_width="$3"
    local -a left_lines right_lines
    mapfile -t left_lines <<<"$left"
    mapfile -t right_lines <<<"$right"
    local max="${#left_lines[@]}"
    [[ "${#right_lines[@]}" -gt "$max" ]] && max="${#right_lines[@]}"
    local i l r
    for (( i = 0; i < max; i++ )); do
        l="${left_lines[i]:-}"
        r="${right_lines[i]:-}"
        l="$(truncate_text "$l" "$col_width")"
        printf '%-*s | %s\n' "$col_width" "$l" "$r"
    done
}

# ------------------------------------------------------------ screens ---

tui_render_help() {
    cat <<EOF
server-toolkit tui ${TOOLKIT_TUI_VERSION}

KEYS:
  r        refresh now
  h or ?   toggle this help
  q        quit

Refresh interval: $(config_get TUI_REFRESH_INTERVAL 5 positive_integer)s (TUI_REFRESH_INTERVAL in config)
Config file:      $(config_path)
Custom modules:   $(modules_enabled && echo enabled || echo disabled)

Press h, H, or ? to return.
EOF
}

# Same alert thresholds bin/info uses - duplicated here deliberately
# rather than refactoring bin/info to share them (see the plan's Global
# Constraints for the rationale). Keep these in sync with bin/info by
# hand if either changes.
TUI_DISK_ALERT_PCT=80
TUI_SWAP_ALERT_PCT=10
TUI_CPU_ALERT_THRESHOLD=90
TUI_LOG_ERROR_LOOKBACK="24 hours ago"
TUI_LOG_ERROR_TIMEOUT=1

tui_strip_pct() {
    local v="${1:-}"
    v="${v%\%}"
    [[ "$v" =~ ^[0-9]+$ ]] && printf '%s' "$v" || printf ''
}

# Each of these builds one panel's display text and returns it via
# stdout only - none of them needs to communicate anything back to the
# caller's scope, so capturing their output via $(...) (which runs them
# in a subshell) is safe. Contrast with the alert-relevant numbers in
# tui_render_overview below, which are deliberately computed inline,
# never inside a function like these.

tui_content_docker() {
    local docker_version
    docker_version="$(get_docker_version)"
    if [[ -n "$docker_version" ]]; then
        local running total healthy
        read -r running total <<<"$(get_docker_container_counts)"
        healthy="$(get_docker_healthy_count)"
        printf 'DOCKER\n'
        printf '  %-10s %s\n' "Containers" "$total"
        printf '  %-10s %s\n' "Running" "$running"
        if [[ -n "$healthy" ]]; then
            printf '  %-10s %s\n' "Healthy" "$healthy"
        fi
    else
        printf 'DOCKER\n  unavailable\n'
    fi
}

tui_content_gpu() {
    local gpu_list
    if gpu_list="$(get_gpu_list)" && [[ -n "$gpu_list" ]]; then
        local idx name driver util mem_used mem_total temp power_draw power_limit
        # shellcheck disable=SC2034 # idx/driver/mem_used/mem_total/temp/power_draw/power_limit unused in this summary view
        IFS=',' read -r idx name driver util mem_used mem_total temp power_draw power_limit <<<"$(head -n1 <<<"$gpu_list")"
        name="$(gpu_trim "$name")"
        util="$(gpu_clean_field "$util")"
        [[ "$util" != "N/A" ]] && util="${util}%"
        printf 'GPU\n'
        printf '  %-10s %s\n' "Status" "Available"
        printf '  %-10s %s\n' "Model" "$name"
        printf '  %-10s %s\n' "Util" "$util"
    else
        printf 'GPU\n  N/A\n'
    fi
}

tui_content_network() {
    local iface
    iface="$(get_primary_interface)"
    if [[ -n "$iface" ]]; then
        printf 'NETWORK\n'
        printf '  %-10s %s\n' "Interface" "$iface"
        printf '  %-10s %s\n' "State" "$(get_interface_state "$iface")"
        printf '  %-10s %s\n' "IPv4" "$(get_ipv4_address "$iface")"
    else
        printf 'NETWORK\n  N/A\n'
    fi
}

tui_content_security() {
    printf 'SECURITY\n'
    printf '  %-10s %s\n' "UFW" "$(get_ufw_status)"
    printf '  %-10s %s\n' "Reboot" "$(get_reboot_required)"
}

# Only ever reaches run_module when modules_enabled() is true - the same
# single gate bin/info already checks (Sprint 12). No new gate, no
# relaxed timeout: this is the identical integration pattern applied a
# second time, not a new one. Appends WARN/ERROR module outcomes into
# the caller's alerts array via a nameref, so module-sourced alerts and
# the built-in threshold alerts render together in one ALERTS section.
tui_gather_module_alerts() {
    local -n _tui_module_alerts="$1"
    modules_enabled || return 0

    local names
    names="$(discover_modules)"
    [[ -z "$names" ]] && return 0

    local name status message output
    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        # shellcheck disable=SC2034 # output unused - the compact ALERTS line only shows status/message
        IFS=$'\t' read -r status message output <<<"$(run_module "$name")"
        case "$status" in
            "$STATUS_WARN") add_alert _tui_module_alerts WARN "module:${name}" "$message" ;;
            "$STATUS_ERROR") add_alert _tui_module_alerts ERROR "module:${name}" "$message" ;;
        esac
    done <<<"$names"
}

# $1 (optional) overrides the layout mode ("full" or "narrow") instead
# of measuring the real terminal via tui_layout_mode - lets tests force
# the narrow path deterministically, since a non-interactive test
# context has no real terminal width for tui_layout_mode to measure and
# would otherwise always fall back to its 80-column ("full") default.
tui_render_overview() {
    printf 'SERVER TOOLKIT%*s%s\n' 46 "" "${TOOLKIT_TUI_VERSION}"
    printf '\n'

    local mode="${1:-}"
    [[ -z "$mode" ]] && mode="$(tui_layout_mode)"

    # --- gather everything the ALERTS section needs, once, right here -
    # never inside a function whose output gets captured (see this
    # task's design note above for why that would silently lose state).
    local ram_alert_pct
    ram_alert_pct="$(config_get RAM_ALERT_PCT 90 percentage)"
    local ram_used ram_total ram_pct swap_used swap_total swap_pct disk_used disk_total disk_pct
    read -r ram_used ram_total ram_pct <<<"$(get_ram_stats)"
    read -r swap_used swap_total swap_pct <<<"$(get_swap_stats)"
    read -r disk_used disk_total disk_pct <<<"$(get_disk_stats)"

    local running_count="N/A" failed_count="N/A"
    if systemd_available; then
        local all_units failed_units
        all_units="$(get_all_service_units)" || all_units=""
        running_count=0
        [[ -n "$all_units" ]] && running_count="$(awk -F'|' '$3=="active"' <<<"$all_units" | wc -l | tr -d '[:space:]')"
        failed_units="$(get_failed_service_units)" || failed_units=""
        failed_count=0
        [[ -n "$failed_units" ]] && failed_count="$(wc -l <<<"$failed_units" | tr -d '[:space:]')"
    fi

    # shellcheck disable=SC2034 # populated via add_alert (nameref) and read via render_alerts
    local alerts=()
    local disk_num ram_num swap_num
    disk_num="$(tui_strip_pct "$disk_pct")"
    [[ -n "$disk_num" && "$disk_num" -ge "$TUI_DISK_ALERT_PCT" ]] && \
        add_alert alerts WARN system "Root disk usage is ${disk_pct}"
    ram_num="$(tui_strip_pct "$ram_pct")"
    [[ -n "$ram_num" && "$ram_num" -ge "$ram_alert_pct" ]] && \
        add_alert alerts WARN system "RAM usage is ${ram_pct}"
    swap_num="$(tui_strip_pct "$swap_pct")"
    [[ -n "$swap_num" && "$swap_num" -ge "$TUI_SWAP_ALERT_PCT" ]] && \
        add_alert alerts WARN system "Swap usage is ${swap_pct} (${swap_used} bytes used)"
    if [[ "$failed_count" =~ ^[0-9]+$ ]] && [[ "$failed_count" -gt 0 ]]; then
        add_alert alerts WARN services "${failed_count} failed systemd service(s)"
    fi
    local snapshot
    if snapshot="$(get_process_snapshot)" && [[ -n "$snapshot" ]]; then
        local high_cpu_count
        high_cpu_count="$(count_above_threshold "$snapshot" 4 "$TUI_CPU_ALERT_THRESHOLD")"
        [[ "$high_cpu_count" =~ ^[0-9]+$ && "$high_cpu_count" -gt 0 ]] && \
            add_alert alerts WARN process "${high_cpu_count} process(es) above ${TUI_CPU_ALERT_THRESHOLD}% CPU"
    fi
    if journalctl_available; then
        local error_count
        error_count="$(get_journal_level_count "err..emerg" "$TUI_LOG_ERROR_LOOKBACK" "$TUI_LOG_ERROR_TIMEOUT")" || error_count=""
        [[ "$error_count" =~ ^[0-9]+$ && "$error_count" -gt 0 ]] && \
            add_alert alerts WARN logs "${error_count} error-level journal entries in the last 24h"
    fi
    tui_gather_module_alerts alerts

    # --- render the panels. resources_content/services_content are
    # built as inline command substitutions (not named functions) since
    # they only need the numbers already computed above, passed in as
    # literal values - this is safe one-way data flow INTO a subshell,
    # not the broken pattern of relying on a subshell's assignment
    # propagating back OUT.
    printf 'SERVER\n'
    printf '  %-12s %s\n' "hostname" "$(get_hostname)"
    printf '  %-12s %s\n' "OS" "$(get_os_pretty_name)"
    printf '  %-12s %s\n' "kernel" "$(get_kernel_version)"
    printf '  %-12s %s\n' "uptime" "$(get_uptime_human)"
    printf '  %-12s %s\n' "load" "$(get_load_average)"
    printf '\n'

    printf 'SYSTEM\n'
    printf '  %-12s %s\n' "CPU" "$(get_cpu_model) ($(get_cpu_topology))"
    if [[ "$ram_total" =~ ^[0-9]+$ ]]; then
        printf '  %-12s %s\n' "RAM" "$(bytes_to_human "$ram_used") / $(bytes_to_human "$ram_total") (${ram_pct})"
    else
        printf '  %-12s %s\n' "RAM" "N/A"
    fi
    if [[ "$swap_total" =~ ^[0-9]+$ ]] && [[ "$swap_total" -gt 0 ]]; then
        printf '  %-12s %s\n' "SWAP" "$(bytes_to_human "$swap_used") / $(bytes_to_human "$swap_total") (${swap_pct})"
    elif [[ "$swap_total" == "0" ]]; then
        printf '  %-12s %s\n' "SWAP" "none configured"
    else
        printf '  %-12s %s\n' "SWAP" "N/A"
    fi
    if [[ "$disk_total" =~ ^[0-9]+$ ]]; then
        printf '  %-12s %s\n' "DISK" "$(bytes_to_human "$disk_used") / $(bytes_to_human "$disk_total") (${disk_pct})"
    else
        printf '  %-12s %s\n' "DISK" "N/A"
    fi
    printf '\n'

    local resources_content services_content docker_content gpu_content network_content security_content
    resources_content="$(printf 'RESOURCES\n  %-10s %s\n  %-10s %s\n' "Memory" "${ram_pct:-N/A}" "Disk" "${disk_pct:-N/A}")"
    services_content="$(printf 'SERVICES\n  %-10s %s\n  %-10s %s\n' "Running" "$running_count" "Failed" "$failed_count")"
    if [[ "$mode" == "full" ]]; then
        tui_two_col "$resources_content" "$services_content" 34
    else
        printf '%s\n%s\n' "$resources_content" "$services_content"
    fi
    printf '\n'

    docker_content="$(tui_content_docker)"
    gpu_content="$(tui_content_gpu)"
    if [[ "$mode" == "full" ]]; then
        tui_two_col "$docker_content" "$gpu_content" 34
    else
        printf '%s\n%s\n' "$docker_content" "$gpu_content"
    fi
    printf '\n'

    network_content="$(tui_content_network)"
    security_content="$(tui_content_security)"
    if [[ "$mode" == "full" ]]; then
        tui_two_col "$network_content" "$security_content" 34
    else
        printf '%s\n%s\n' "$network_content" "$security_content"
    fi
    printf '\n'

    printf 'ALERTS\n'
    render_alerts alerts "No active alerts"
}

# ------------------------------------------------------- terminal I/O ---

TUI_ORIG_STTY=""
TUI_SHOWING_HELP=0

tui_cleanup() {
    tput cnorm 2>/dev/null || true
    tput rmcup 2>/dev/null || true
    # shellcheck disable=SC2015 # the `|| true` is not an else-branch: it just forces this line's exit status to 0 either way
    [[ -n "$TUI_ORIG_STTY" ]] && stty "$TUI_ORIG_STTY" 2>/dev/null || true
}

tui_render_frame() {
    tput clear 2>/dev/null || true
    if [[ "$TUI_SHOWING_HELP" -eq 1 ]]; then
        tui_render_help
    else
        tui_render_overview
    fi
}

tui_main() {
    if [[ -z "${TUI_ONCE:-}" ]]; then
        if [[ ! -t 0 || ! -t 1 ]]; then
            printf 'server-toolkit tui: requires an interactive terminal (stdin/stdout must both be a TTY)\n' >&2
            exit 1
        fi
    fi

    if [[ -n "${TUI_ONCE:-}" ]]; then
        tui_render_overview
        exit 0
    fi

    TUI_ORIG_STTY="$(stty -g 2>/dev/null)" || TUI_ORIG_STTY=""
    # A trapped signal's handler returning normally resumes execution in
    # bash rather than terminating the process - so INT/TERM need their
    # own handlers that explicitly exit (with the conventional
    # 128+signal exit codes) after cleanup, not just the shared EXIT
    # trap. tui_cleanup is idempotent (every line ends in `|| true`), so
    # running it twice on a signal path (once here, once again from the
    # exit it triggers) is safe.
    trap tui_cleanup EXIT
    trap 'tui_cleanup; exit 130' INT
    trap 'tui_cleanup; exit 143' TERM
    tput smcup 2>/dev/null || true
    tput civis 2>/dev/null || true

    local interval key action
    interval="$(config_get TUI_REFRESH_INTERVAL 5 positive_integer)"

    while true; do
        tui_render_frame
        key=""
        read -r -t "$interval" -n 1 -s key || true
        action="$(tui_key_action "$key")"
        case "$action" in
            quit) break ;;
            help) TUI_SHOWING_HELP=$(( 1 - TUI_SHOWING_HELP )) ;;
            refresh|timeout|ignore) : ;;
        esac
    done
}

# Only run the interactive loop when this file is executed directly, not
# when it's sourced (e.g. by tests, to call the pure functions above in
# isolation without triggering the loop or the TTY check).
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    tui_main
fi
