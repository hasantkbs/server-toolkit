#!/usr/bin/env bash
# server-toolkit - single entry point / dispatcher for server-toolkit's
# individual bin/*-info commands (Sprint 13, CLI/command UX).
#
# SECURITY: command resolution is a fixed, explicit mapping (the `case`
# statement below) from a small set of literal command names to a small
# set of literal target paths - no dynamic command construction or shell
# re-interpretation of user input, and no path built by concatenating
# user input into a filename. An unrecognized command is only ever used
# as inert text (printed via printf %s in an error message), never
# executed or interpreted.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"
BIN_DIR="$SCRIPT_DIR"

# The one place this version string is defined - bump it here only.
TOOLKIT_VERSION="0.13.0-dev"

print_help() {
    cat <<'EOF'
server-toolkit - Bash-based, read-only server diagnostics toolkit

USAGE:
  server-toolkit [COMMAND] [ARGS]

Running with no command shows the `info` dashboard.

COMMANDS:
  info       System dashboard
  gpu        GPU diagnostics
  docker     Docker diagnostics
  network    Network diagnostics
  storage    Storage diagnostics
  services   Service diagnostics
  security   Security diagnostics
  process    Process diagnostics
  logs       Journal/log diagnostics
  backup     Backup discovery
  tui        Terminal dashboard (interactive)
  modules    Custom modules
  config     Configuration
  version    Show version
  help       Show help

Each command behaves identically to its standalone counterpart (info,
gpu-info, docker-info, ...) - this dispatcher is a thin layer over them,
not a replacement. Those standalone commands keep working directly too.

Run 'server-toolkit <command> --help' (or -h) for a command's own usage.
EOF
}

print_version() {
    printf 'server-toolkit %s\n' "$TOOLKIT_VERSION"
}

# Shows discovered custom modules and their enabled/disabled status.
# Read-only introspection only: calls discover_modules/read_module_file
# (lib/modules.sh's own discovery/parsing, which never execute anything
# by design) and NEVER calls run_module - this command must never run a
# module's COMMAND, preserving Sprint 12's exact execution trust model.
cmd_modules() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        printf 'server-toolkit modules - lists discovered custom modules and their status\n\n'
        printf 'USAGE:\n'
        printf '  server-toolkit modules\n\n'
        printf 'Read-only introspection only - never runs a module. See docs/modules.md.\n'
        return 0
    fi
    if ! modules_enabled; then
        printf 'Custom modules are disabled (CUSTOM_MODULES_ENABLED=false).\n'
        printf 'Enable them by adding CUSTOM_MODULES_ENABLED=true to the main config file.\n'
        printf 'See docs/modules.md for details.\n'
        return 0
    fi

    local names
    names="$(discover_modules)"
    if [[ -z "$names" ]]; then
        printf 'Custom modules are enabled, but no modules were found under %s.\n' "$(modules_dir)"
        return 0
    fi

    printf '%-20s %-10s %s\n' "MODULE" "STATUS" "COMMAND"
    local name path status
    local -A fields
    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        path="$(modules_dir)/${name}.conf"
        fields=()
        if ! read_module_file "$path" fields; then
            printf '%-20s %-10s %s\n' "$name" "error" "(unreadable)"
            continue
        fi
        status="disabled"
        [[ "${fields[ENABLED]:-}" == "true" ]] && status="enabled"
        printf '%-20s %-10s %s\n' "$name" "$status" "${fields[COMMAND]:-(none)}"
    done <<<"$names"
}

# Read-only configuration helper: `path` prints the resolved config file
# path, `show` prints its raw content (or says none exists, or warns if
# the file exists but would be ignored for unsafe ownership/permissions -
# reusing lib/config.sh's own trust check, not a second implementation of
# it). Never modifies configuration - there is no "set"/"edit" subcommand
# by design; this sprint keeps config read-only.
cmd_config() {
    local sub="${1:-show}"
    case "$sub" in
        --help|-h)
            printf 'server-toolkit config - read-only configuration helper\n\n'
            printf 'USAGE:\n'
            printf '  server-toolkit config [path|show]\n\n'
            printf '  path   Print the resolved config file path\n'
            printf '  show   Print the config file'"'"'s content (default)\n\n'
            printf 'Read-only - there is no config-editing subcommand. See docs/config.md.\n'
            ;;
        path)
            config_path
            printf '\n'
            ;;
        show)
            local path
            path="$(config_path)"
            if [[ ! -f "$path" ]]; then
                printf 'No config file at %s.\n' "$path"
                printf '(server-toolkit is running with default values.)\n'
                return 0
            fi
            if ! _config_permissions_safe "$path"; then
                printf 'WARNING: %s is not owned by you, or is writable by others - server-toolkit ignores it and uses defaults.\n\n' "$path"
            fi
            printf 'Config file: %s\n\n' "$path"
            cat -- "$path"
            ;;
        *)
            printf 'server-toolkit: unknown config subcommand: %s\n' "$sub" >&2
            printf "Available: 'server-toolkit config path', 'server-toolkit config show'\n" >&2
            return 1
            ;;
    esac
}

cmd="${1:-info}"
[[ $# -gt 0 ]] && shift

case "$cmd" in
    info)     target="${BIN_DIR}/info" ;;
    gpu)      target="${BIN_DIR}/gpu-info" ;;
    docker)   target="${BIN_DIR}/docker-info" ;;
    network)  target="${BIN_DIR}/network-info" ;;
    storage)  target="${BIN_DIR}/storage-info" ;;
    services) target="${BIN_DIR}/services-info" ;;
    security) target="${BIN_DIR}/security-info" ;;
    process)  target="${BIN_DIR}/process-info" ;;
    logs)     target="${BIN_DIR}/logs-info" ;;
    backup)   target="${BIN_DIR}/backup-info" ;;
    tui)      target="${BIN_DIR}/tui" ;;
    modules)
        LIB_DIR="$(cd -- "${SCRIPT_DIR}/../lib" >/dev/null 2>&1 && pwd -P)"
        # shellcheck source=../lib/common.sh
        source "${LIB_DIR}/common.sh"
        # shellcheck source=../lib/config.sh
        source "${LIB_DIR}/config.sh"
        # shellcheck source=../lib/modules.sh
        source "${LIB_DIR}/modules.sh"
        cmd_modules "$@"
        exit $?
        ;;
    config)
        LIB_DIR="$(cd -- "${SCRIPT_DIR}/../lib" >/dev/null 2>&1 && pwd -P)"
        # shellcheck source=../lib/common.sh
        source "${LIB_DIR}/common.sh"
        # shellcheck source=../lib/config.sh
        source "${LIB_DIR}/config.sh"
        cmd_config "$@"
        exit $?
        ;;
    version|--version|-V)
        print_version
        exit 0
        ;;
    help|--help|-h)
        print_help
        exit 0
        ;;
    *)
        printf 'server-toolkit: unknown command: %s\n' "$cmd" >&2
        printf "Run 'server-toolkit help' to see available commands.\n" >&2
        exit 127
        ;;
esac

if [[ ! -x "$target" ]]; then
    printf 'server-toolkit: command not found or not executable: %s\n' "$target" >&2
    exit 1
fi

exec "$target" "$@"
